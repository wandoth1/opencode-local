@@ -0,0 +1,113 @@
+import { afterEach, expect, test } from "bun:test"
+import { configureOllama } from "@/local/ollama/integration"
+
+const originalFetch = globalThis.fetch
+const originalDisable = process.env.OPENCODE_LOCAL_DISABLE
+
+afterEach(() => {
+  globalThis.fetch = originalFetch
+  if (originalDisable === undefined) delete process.env.OPENCODE_LOCAL_DISABLE
+  else process.env.OPENCODE_LOCAL_DISABLE = originalDisable
+})
+
+function json(body: unknown) {
+  return new Response(JSON.stringify(body), { status: 200, headers: { "Content-Type": "application/json" } })
+}
+
+test("injects an in-memory Ollama provider without changing core provider code", async () => {
+  globalThis.fetch = (async (input) => {
+    const url = String(input)
+    if (url.endsWith("/api/tags")) {
+      return json({
+        models: [
+          {
+            name: "qwen3-coder:8b",
+            model: "qwen3-coder:8b",
+            size: 5_000_000_000,
+            details: {
+              family: "qwen3",
+              families: ["qwen3"],
+              parameter_size: "8B",
+              quantization_level: "Q4_K_M",
+              format: "gguf",
+            },
+          },
+        ],
+      })
+    }
+    if (url.endsWith("/api/show")) {
+      return json({
+        capabilities: ["completion", "tools", "thinking"],
+        model_info: {
+          "general.architecture": "qwen3",
+          "qwen3.context_length": 32768,
+          "qwen3.block_count": 32,
+          "qwen3.embedding_length": 4096,
+          "qwen3.attention.head_count": 32,
+          "qwen3.attention.head_count_kv": 8,
+        },
+      })
+    }
+    if (url.endsWith("/api/ps")) return json({ models: [] })
+    if (url.endsWith("/api/version")) return json({ version: "0.test" })
+    throw new Error(`Unexpected request: ${url}`)
+  }) as typeof fetch
+
+  const config: any = {}
+  await configureOllama(config)
+
+  expect(config.provider.ollama.name).toBe("Ollama (local)")
+  expect(config.provider.ollama.npm).toBe("@ai-sdk/openai-compatible")
+  expect(config.provider.ollama.options.baseURL).toBe("http://127.0.0.1:11434/v1")
+  expect(typeof config.provider.ollama.options.fetch).toBe("function")
+  expect(config.provider.ollama.models["qwen3-coder:8b"].tool_call).toBe(true)
+  expect(config.provider.ollama.models["qwen3-coder:8b"].reasoning).toBe(true)
+})
+
+
+test("keeps explicit model configuration authoritative over discovery", async () => {
+  globalThis.fetch = (async (input) => {
+    const url = String(input)
+    if (url.endsWith("/api/tags")) {
+      return json({
+        models: [
+          {
+            name: "qwen3-coder:8b",
+            model: "qwen3-coder:8b",
+            size: 5_000_000_000,
+            details: { family: "qwen3", parameter_size: "8B", quantization_level: "Q4_K_M" },
+          },
+        ],
+      })
+    }
+    if (url.endsWith("/api/show")) return json({ capabilities: ["completion", "tools"], model_info: {} })
+    if (url.endsWith("/api/ps")) return json({ models: [] })
+    if (url.endsWith("/api/version")) return json({ version: "0.test" })
+    throw new Error(`Unexpected request: ${url}`)
+  }) as typeof fetch
+
+  const config: any = {
+    provider: {
+      ollama: {
+        models: {
+          "qwen3-coder:8b": {
+            name: "My explicit local model",
+            limit: { context: 12_288, output: 2_048 },
+            tool_call: false,
+          },
+        },
+      },
+    },
+  }
+  await configureOllama(config)
+
+  expect(config.provider.ollama.models["qwen3-coder:8b"].name).toBe("My explicit local model")
+  expect(config.provider.ollama.models["qwen3-coder:8b"].limit.context).toBe(12_288)
+})
+
+test("respects the global local-runtime opt-out", async () => {
+  process.env.OPENCODE_LOCAL_DISABLE = "1"
+  const config: any = {}
+  await configureOllama(config)
+  expect(config.provider).toBeUndefined()
+})
